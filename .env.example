# Supabase PostgreSQL - use a string copiada em Connect > Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST_POOLER:5432/postgres?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=5
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# Necessária somente durante a migração dos dados antigos.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST/deliveryDB
# Opcional se o nome do banco já estiver na MONGODB_URI.
MONGODB_DB_NAME=deliveryDB

# Variáveis já usadas pelo Rappidex.
JWT_SECRET_KEY=troque-por-um-segredo-forte
NODE_ENV=production
FRONTEND_URLS=https://seu-frontend.vercel.app

# iFood - mantenha os valores atuais do ambiente de produção.
IFOOD_AUTH_MODE=centralized
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_POLLING_ENABLED=true
IFOOD_POLLING_INTERVAL_MS=30000

# Importação de histórico MongoDB -> Supabase (opcional)
# Por padrão, logs e eventos brutos iFood NÃO são importados.
IMPORT_HEAVY_HISTORY=false
MIGRATION_BATCH_SIZE=200
# Evita reutilizar IDs antigos do OneSignal no ambiente de teste.
IMPORT_NOTIFICATION_SUBSCRIPTIONS=false
